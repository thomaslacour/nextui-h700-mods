+	// Save Sync : tactile à la croix, pour les cœurs DS sur une console sans
+	// écran tactile ni stick (pak MELONDS : MINARCH_DPAD_TOUCH=1). L2 maintenu :
+	// la croix devient le stick droit (curseur « joystick » de melonDS DS) et A
+	// l'appui sur l'écran (R2 libretro) ; relâché, tout redevient normal.
+	static int dpad_touch = -1;
+	if (dpad_touch < 0) dpad_touch = getenv("MINARCH_DPAD_TOUCH") != NULL;
+	if (dpad_touch) {
+		pad.raxis.x = pad.raxis.y = 0; // pas de stick droit sur la console
+		if (PAD_isPressed(BTN_L2)) {
+			if (PAD_isPressed(BTN_LEFT))  pad.raxis.x = -32767;
+			if (PAD_isPressed(BTN_RIGHT)) pad.raxis.x =  32767;
+			if (PAD_isPressed(BTN_UP))    pad.raxis.y = -32767;
+			if (PAD_isPressed(BTN_DOWN))  pad.raxis.y =  32767;
+			buttons &= ~((1 << RETRO_DEVICE_ID_JOYPAD_UP) | (1 << RETRO_DEVICE_ID_JOYPAD_DOWN) |
+			             (1 << RETRO_DEVICE_ID_JOYPAD_LEFT) | (1 << RETRO_DEVICE_ID_JOYPAD_RIGHT) |
+			             (1 << RETRO_DEVICE_ID_JOYPAD_A));
+			if (PAD_isPressed(BTN_A)) buttons |= 1 << RETRO_DEVICE_ID_JOYPAD_R2;
+		}
+	}
 }
