+#pragma once
+
+#include "menu.hpp"
+#include <atomic>
+#include <mutex>
+#include <thread>
+
+// Settings > VPN: Tailscale control without the Tailscale pak's own screen.
+// The binaries still come from Tools/<platform>/Tailscale.pak (or
+// Tailscale.pak.disabled once the pak is hidden from Tools); the node state
+// stays in .userdata/<platform>/Tailscale/, shared with the pak.
+namespace Vpn
+{
+    // true if a Tailscale install (pak, visible or hidden) is present
+    bool available();
+
+    struct Status
+    {
+        bool installed = false;
+        bool running = false;    // tailscaled process alive
+        bool responding = false; // LocalAPI answered
+        std::string backend;     // BackendState (Running, NeedsLogin, Stopped...)
+        std::string ip;          // first Tailscale IPv4
+        std::string host;        // Self.HostName
+        std::string dns;         // Self.DNSName, without the trailing dot
+        bool operator==(const Status &o) const
+        {
+            return installed == o.installed && running == o.running && responding == o.responding &&
+                   backend == o.backend && ip == o.ip && host == o.host && dns == o.dns;
+        }
+    };
+
+    class Menu : public MenuList
+    {
+        const int &globalQuit;
+        int &globalDirty;
+
+        MenuItem *toggleItem;
+        MenuItem *bootItem;
+        StaticMenuItem *statusItem;
+        StaticMenuItem *addressItem;
+        StaticMenuItem *hostItem;
+
+        std::thread worker;
+        std::atomic<bool> quit{false};
+        std::atomic<bool> selectionDirty{false};
+
+        mutable std::mutex stateLock; // guards status
+        Status status;
+        std::mutex opLock; // held while starting/stopping
+
+    public:
+        Menu(const int &globalQuit, int &globalDirty);
+        ~Menu();
+
+        InputReactionHint handleInput(int &dirty, int &quit) override;
+
+    private:
+        Status snapshot() const;
+        bool store(const Status &s);
+        void updateItems();
+        void updater();
+
+        std::any getEnabled() const;
+        void setEnabled(const std::any &on);
+        std::any getBoot() const;
+        void setBoot(const std::any &on);
+
+        std::any statusLabel() const;
+        std::any addressLabel() const;
+        std::any hostLabel() const;
+    };
+}
