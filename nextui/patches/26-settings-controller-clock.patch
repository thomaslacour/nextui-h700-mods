+++ b/workspace/all/settings/clockmenu.hpp
@@ -0,0 +1,27 @@
+#pragma once
+
+#include "menu.hpp"
+
+// Manual date and time in Settings > System (replaces the Clock tool, hidden
+// from Tools by the launcher). The "Date and time" row is only listed while
+// "Set time and date automatically" is off.
+namespace Clock
+{
+    // "Date and time" row: shows the current time, A opens the editor.
+    AbstractMenuItem *buildDateTimeItem();
+
+    // A Fixed list that shows dateTime only while network time sync is off.
+    // dateTime must be one of items; this menu owns it either way.
+    class SystemMenu : public MenuList
+    {
+        AbstractMenuItem *dateTime;
+        int position{0};
+        bool shown{true};
+        bool sync();
+
+    public:
+        SystemMenu(const std::string &desc, std::vector<AbstractMenuItem *> items, AbstractMenuItem *dateTime);
+        ~SystemMenu();
+        InputReactionHint handleInput(int &dirty, int &quit) override;
+    };
+}
diff --git a/workspace/all/settings/controllermenu.cpp b/workspace/all/settings/controllermenu.cpp
new file mode 100644
index 0000000..289ef05
--- /dev/null
+++ b/workspace/all/settings/controllermenu.cpp
@@ -0,0 +1,98 @@
+#include "controllermenu.hpp"
+
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <string>
+
+#include <limits.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace
+{
+    const char *PAK_DIR = TOOLS_PATH "/Pad Setup.pak";
+    const char *REOPEN_ENV = "NEXTUI_SETTINGS_MENU";
+    const char *REOPEN_VALUE = "Controller";
+
+    std::string queued; // shell command run by runQueued()
+
+    std::string quoted(const std::string &s)
+    {
+        std::string out = "'";
+        for (char c : s)
+            out += (c == '\'') ? std::string("'\\''") : std::string(1, c);
+        return out + "'";
+    }
+
+    // External pads: js0 is the built-in controls, js1 and up are pads
+    // (same rule as the status bar icon).
+    std::string connectedLabel()
+    {
+        std::string first;
+        int count = 0;
+        for (int i = 1; i < 10; i++)
+        {
+            std::ifstream in("/sys/class/input/js" + std::to_string(i) + "/device/name");
+            if (!in.good())
+                continue;
+            std::string name;
+            std::getline(in, name);
+            if (count++ == 0)
+                first = name.empty() ? std::string("1 controller") : name;
+        }
+        if (count == 0)
+            return "None";
+        if (count == 1)
+            return first;
+        return std::to_string(count) + " controllers";
+    }
+}
+
+bool Controller::available()
+{
+    return access((std::string(PAK_DIR) + "/launch.sh").c_str(), R_OK) == 0;
+}
+
+MenuList *Controller::buildMenu(int &appQuit)
+{
+    int *quit = &appQuit;
+    return new MenuList(MenuItemType::Fixed, "Controller",
+    {
+        new StaticMenuItem{ListItemType::Generic, "Connected", "External controllers seen by the system",
+        []() -> std::any { return connectedLabel(); }},
+        new MenuItem{ListItemType::Button, "Pad Setup", "Map the buttons of an external controller\nthat the games read wrongly. Back here afterwards.",
+        [quit](AbstractMenuItem &item) -> InputReactionHint {
+            char cwd[PATH_MAX];
+            if (!available() || !getcwd(cwd, sizeof(cwd))) {
+                item.setDesc("Pad Setup is not installed");
+                return NoOp;
+            }
+            // The pak, then Settings again from its own folder (launch.sh
+            // does a cd there), opened on this menu.
+            queued = quoted(std::string(PAK_DIR) + "/launch.sh") + "; cd " + quoted(cwd) +
+                     " && " + REOPEN_ENV + "=" + REOPEN_VALUE + " exec ./launch.sh";
+            *quit = 1;
+            return NoOp;
+        }},
+    });
+}
+
+bool Controller::reopenRequested()
+{
+    const char *v = getenv(REOPEN_ENV);
+    bool yes = v && strcmp(v, REOPEN_VALUE) == 0;
+    unsetenv(REOPEN_ENV);
+    return yes;
+}
+
+void Controller::runQueued()
+{
+    if (queued.empty())
+        return;
+    LOG_info("Controller: running %s\n", queued.c_str());
+    fflush(stdout);
+    fflush(stderr);
+    execl("/bin/sh", "sh", "-c", queued.c_str(), (char *)NULL);
+    LOG_error("Controller: exec failed\n");
+}
diff --git a/workspace/all/settings/controllermenu.hpp b/workspace/all/settings/controllermenu.hpp
new file mode 100644
index 0000000..1fe2655
--- /dev/null
+++ b/workspace/all/settings/controllermenu.hpp
@@ -0,0 +1,22 @@
+#pragma once
+
+#include "menu.hpp"
+
+// Settings > Controller: external pads. "Pad Setup" runs the Pad Setup pak
+// (Tools/<platform>/Pad Setup.pak, hidden from Tools by the launcher) once
+// Settings has exited, then reopens Settings on this menu.
+namespace Controller
+{
+    // The Pad Setup pak is installed.
+    bool available();
+
+    // The menu; picking "Pad Setup" sets appQuit and queues the pak.
+    MenuList *buildMenu(int &appQuit);
+
+    // Settings was relaunched by the pak: open this menu right away (once).
+    bool reopenRequested();
+
+    // Call last, after GFX_quit(): replaces Settings with the queued pak, if
+    // any (returns only when nothing is queued or exec failed).
+    void runQueued();
+}
