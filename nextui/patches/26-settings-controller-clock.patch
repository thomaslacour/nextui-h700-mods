diff --git a/workspace/all/settings/clockmenu.cpp b/workspace/all/settings/clockmenu.cpp
new file mode 100644
index 0000000..6955007
--- /dev/null
+++ b/workspace/all/settings/clockmenu.cpp
@@ -0,0 +1,176 @@
+#include "clockmenu.hpp"
+
+#include <cstdio>
+#include <ctime>
+#include <mutex>
+
+using namespace Clock;
+
+namespace
+{
+    // Values being edited, loaded from the system clock when the editor opens.
+    struct Pending
+    {
+        int year, month, day, hour, minute;
+    } pending;
+
+    const std::vector<std::string> MONTHS = {"January", "February", "March", "April", "May", "June", "July",
+                                             "August", "September", "October", "November", "December"};
+
+    void loadNow()
+    {
+        time_t t = time(NULL);
+        struct tm tm = *localtime(&t);
+        pending = {tm.tm_year + 1900, tm.tm_mon + 1, tm.tm_mday, tm.tm_hour, tm.tm_min};
+    }
+
+    int daysIn(int year, int month)
+    {
+        static const int days[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+        bool leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
+        return (month == 2 && leap) ? 29 : days[month - 1];
+    }
+
+    std::string hourLabel(int h, bool h24)
+    {
+        char buf[16];
+        if (h24)
+            snprintf(buf, sizeof(buf), "%02d", h);
+        else
+            snprintf(buf, sizeof(buf), "%d %s", h % 12 == 0 ? 12 : h % 12, h < 12 ? "AM" : "PM");
+        return buf;
+    }
+
+    std::vector<std::any> range(int from, int to)
+    {
+        std::vector<std::any> v;
+        for (int i = from; i <= to; i++)
+            v.push_back(i);
+        return v;
+    }
+
+    std::vector<std::string> labels(int from, int to, const char *fmt)
+    {
+        std::vector<std::string> v;
+        char buf[16];
+        for (int i = from; i <= to; i++)
+        {
+            snprintf(buf, sizeof(buf), fmt, i);
+            v.push_back(buf);
+        }
+        return v;
+    }
+
+    MenuItem *field(const std::string &name, const std::string &desc, int from, int to,
+                    const std::vector<std::string> &names, int Pending::*member)
+    {
+        return new MenuItem{ListItemType::Generic, name, desc, range(from, to), names,
+                            [member]() -> std::any { return pending.*member; },
+                            [member](const std::any &v) { pending.*member = std::any_cast<int>(v); }};
+    }
+
+    // The row in System: label = current date and time.
+    class DateTimeItem : public MenuItem
+    {
+    public:
+        using MenuItem::MenuItem;
+        const std::string getLabel() const override
+        {
+            time_t t = time(NULL);
+            char buf[32];
+            strftime(buf, sizeof(buf), CFG_getClock24H() ? "%Y-%m-%d %H:%M" : "%Y-%m-%d %I:%M %p", localtime(&t));
+            return buf;
+        }
+    };
+}
+
+AbstractMenuItem *Clock::buildDateTimeItem()
+{
+    loadNow();
+    bool h24 = CFG_getClock24H();
+    std::vector<std::string> hours;
+    for (int h = 0; h < 24; h++)
+        hours.push_back(hourLabel(h, h24));
+
+    std::vector<MenuItem *> fields = {
+        field("Year", "", 2000, 2099, labels(2000, 2099, "%d"), &Pending::year),
+        field("Month", "", 1, 12, MONTHS, &Pending::month),
+        field("Day", "Clamped to the length of the month", 1, 31, labels(1, 31, "%d"), &Pending::day),
+        field("Hour", "", 0, 23, hours, &Pending::hour),
+        field("Minute", "Seconds are set to 00", 0, 59, labels(0, 59, "%02d"), &Pending::minute),
+    };
+    std::vector<AbstractMenuItem *> items(fields.begin(), fields.end());
+    items.push_back(new MenuItem{ListItemType::Button, "Set date and time", "Apply now. B leaves without changing the clock.",
+        [](AbstractMenuItem &item) -> InputReactionHint {
+            int day = std::min(pending.day, daysIn(pending.year, pending.month));
+            PLAT_setDateTime(pending.year, pending.month, day, pending.hour, pending.minute, 0);
+            return Exit; // back to System
+        }});
+    auto *editor = new MenuList(MenuItemType::Fixed, "Date and time", items);
+
+    return new DateTimeItem{ListItemType::Generic, "Date and time", "Set the clock by hand.\nOnly while automatic time is off.",
+        std::vector<std::any>{0}, std::vector<std::string>{""}, nullptr, nullptr, nullptr,
+        [fields](AbstractMenuItem &item) -> InputReactionHint {
+            loadNow();
+            for (auto *f : fields)
+                f->reselect();
+            return DeferToSubmenu(item);
+        }, editor};
+}
+
+SystemMenu::SystemMenu(const std::string &desc, std::vector<AbstractMenuItem *> items, AbstractMenuItem *dateTime)
+    : MenuList(MenuItemType::Fixed, desc, items), dateTime(dateTime)
+{
+    auto it = std::find(items.begin(), items.end(), dateTime);
+    assert(it != items.end());
+    position = (int)(it - items.begin());
+    sync();
+}
+
+SystemMenu::~SystemMenu()
+{
+    if (!shown)
+        delete dateTime; // not in items, the base class would not free it
+}
+
+InputReactionHint SystemMenu::handleInput(int &dirty, int &quit)
+{
+    InputReactionHint hint = MenuList::handleInput(dirty, quit);
+    if (sync())
+        dirty = 1;
+    return hint;
+}
+
+// Adds or removes the row to follow the network time setting; true if changed.
+bool SystemMenu::sync()
+{
+    bool want = !TIME_getNetworkTimeSync();
+    if (want == shown)
+        return false;
+
+    std::unique_lock<std::shared_mutex> w(itemLock);
+    if (want)
+    {
+        items.insert(items.begin() + position, dateTime);
+        if (scope.selected >= position)
+            scope.selected++;
+    }
+    else
+    {
+        items.erase(items.begin() + position);
+        if (scope.selected > position)
+            scope.selected--;
+    }
+    shown = want;
+
+    scope.count = (int)items.size();
+    scope.selected = std::max(0, std::min(scope.selected, scope.count - 1));
+    scope.visible_rows = std::min(scope.count, scope.max_visible_options);
+    if (scope.selected < scope.start)
+        scope.start = scope.selected;
+    if (scope.selected >= scope.start + scope.visible_rows)
+        scope.start = scope.selected - scope.visible_rows + 1;
+    scope.start = std::max(0, std::min(scope.start, scope.count - scope.visible_rows));
+    scope.end = scope.start + scope.visible_rows;
+    return true;
+}
