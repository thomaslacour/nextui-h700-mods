+// External pads known to the SDL GameController database (USERDATA_PATH/
+// gamecontrollerdb.txt, installed from the Mac) are read through the
+// GameController API: buttons by position whatever the pad (8BitDo, Xbox,
+// PlayStation, Switch Pro...), Home = MENU, analog triggers = L2/R2 and both
+// sticks analog. Face buttons: in the launcher and paks, Xbox style like the
+// database itself (bottom = A, so the bottom button confirms); in games
+// (minarch) by position like the built-in pad (bottom = B, right = A, left = Y,
+// top = X), so a PS1 game gets Cross at the bottom, Circle on the right.
+// Unknown pads keep the raw joystick path (JOY_* layout).
+#define PAD_DB_PATH USERDATA_PATH "/gamecontrollerdb.txt"
+#define MAX_CONTROLLERS 8
+#define TRIGGER_PRESS 16384
+static SDL_GameController *controllers[MAX_CONTROLLERS];
+static int num_controllers = 0;
+
+static int controller_slot(SDL_JoystickID which) {
+	for (int i = 0; i < num_controllers; i++)
+		if (SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(controllers[i])) == which)
+			return i;
+	return -1;
+}
+
+// Opens device <index> as a GameController when the database knows it.
+static int open_controller(int index) {
+	if (!SDL_IsGameController(index) || num_controllers >= MAX_CONTROLLERS)
+		return 0;
+	SDL_GameController *gc = SDL_GameControllerOpen(index);
+	if (!gc) {
+		LOG_error("Failed to open game controller %d: %s\n", index, SDL_GetError());
+		return 0;
+	}
+	controllers[num_controllers++] = gc;
+	LOG_info("Opening game controller %d: %s\n", index, SDL_GameControllerName(gc));
+	return 1;
+}
+
+static void close_controller(int slot) {
+	LOG_info("Closing game controller: %s\n", SDL_GameControllerName(controllers[slot]));
+	SDL_GameControllerClose(controllers[slot]);
+	for (int j = slot; j < num_controllers - 1; j++)
+		controllers[j] = controllers[j + 1];
+	num_controllers--;
+}
+
+extern char *program_invocation_short_name; // glibc
+static int controller_positional(void) {
+	static int positional = -1;
+	if (positional < 0)
+		positional = strcmp(program_invocation_short_name, "minarch.elf") == 0;
+	return positional;
+}
+
+static int button_from_controller(int b, int *id) {
+	if (controller_positional()) {
+		switch (b) {
+		case SDL_CONTROLLER_BUTTON_A: b = SDL_CONTROLLER_BUTTON_B; break;
+		case SDL_CONTROLLER_BUTTON_B: b = SDL_CONTROLLER_BUTTON_A; break;
+		case SDL_CONTROLLER_BUTTON_X: b = SDL_CONTROLLER_BUTTON_Y; break;
+		case SDL_CONTROLLER_BUTTON_Y: b = SDL_CONTROLLER_BUTTON_X; break;
+		}
+	}
+	switch (b) {
+	case SDL_CONTROLLER_BUTTON_DPAD_UP:       *id = BTN_ID_DPAD_UP;    return BTN_DPAD_UP;
+	case SDL_CONTROLLER_BUTTON_DPAD_DOWN:     *id = BTN_ID_DPAD_DOWN;  return BTN_DPAD_DOWN;
+	case SDL_CONTROLLER_BUTTON_DPAD_LEFT:     *id = BTN_ID_DPAD_LEFT;  return BTN_DPAD_LEFT;
+	case SDL_CONTROLLER_BUTTON_DPAD_RIGHT:    *id = BTN_ID_DPAD_RIGHT; return BTN_DPAD_RIGHT;
+	case SDL_CONTROLLER_BUTTON_A:             *id = BTN_ID_A;          return BTN_A;
+	case SDL_CONTROLLER_BUTTON_B:             *id = BTN_ID_B;          return BTN_B;
+	case SDL_CONTROLLER_BUTTON_X:             *id = BTN_ID_X;          return BTN_X;
+	case SDL_CONTROLLER_BUTTON_Y:             *id = BTN_ID_Y;          return BTN_Y;
+	case SDL_CONTROLLER_BUTTON_BACK:          *id = BTN_ID_SELECT;     return BTN_SELECT;
+	case SDL_CONTROLLER_BUTTON_START:         *id = BTN_ID_START;      return BTN_START;
+	case SDL_CONTROLLER_BUTTON_GUIDE:         *id = BTN_ID_MENU;       return BTN_MENU;
+	case SDL_CONTROLLER_BUTTON_LEFTSHOULDER:  *id = BTN_ID_L1;         return BTN_L1;
+	case SDL_CONTROLLER_BUTTON_RIGHTSHOULDER: *id = BTN_ID_R1;         return BTN_R1;
+	case SDL_CONTROLLER_BUTTON_LEFTSTICK:     *id = BTN_ID_L3;         return BTN_L3;
+	case SDL_CONTROLLER_BUTTON_RIGHTSTICK:    *id = BTN_ID_R3;         return BTN_R3;
+	default:                                  *id = -1;                return BTN_NONE;
+	}
+}
+
+static void apply_controller_axis(int axis, int val, uint32_t tick) {
+	switch (axis) {
+	case SDL_CONTROLLER_AXIS_LEFTX:
+		pad.laxis.x = val;
+		PAD_setAnalog(BTN_ID_ANALOG_LEFT, BTN_ID_ANALOG_RIGHT, val, tick + PAD_REPEAT_DELAY);
+		break;
+	case SDL_CONTROLLER_AXIS_LEFTY:
+		pad.laxis.y = val;
+		PAD_setAnalog(BTN_ID_ANALOG_UP, BTN_ID_ANALOG_DOWN, val, tick + PAD_REPEAT_DELAY);
+		break;
+	case SDL_CONTROLLER_AXIS_RIGHTX: pad.raxis.x = val; break;
+	case SDL_CONTROLLER_AXIS_RIGHTY: pad.raxis.y = val; break;
+	case SDL_CONTROLLER_AXIS_TRIGGERLEFT:  apply_button_state(BTN_L2, BTN_ID_L2, val > TRIGGER_PRESS, tick); break;
+	case SDL_CONTROLLER_AXIS_TRIGGERRIGHT: apply_button_state(BTN_R2, BTN_ID_R2, val > TRIGGER_PRESS, tick); break;
+	}
+}
