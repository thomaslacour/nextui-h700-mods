 extern char *program_invocation_short_name; // glibc
+// External pad face buttons: Xbox style (SDL's own layout: bottom = A) in the
+// launcher, the paks, minarch's menu and Nintendo games; by position like the
+// built-in pad (bottom = B) while other systems' games run, which already gives
+// the PlayStation layout (Cross at the bottom), and in Nintendo games when
+// minarch Controls > "Pad buttons" is Original. The system is the "(TAG)" of
+// the ROM folder, minarch's 2nd argument.
+static int rom_is_nintendo(void) {
+	static const char *tags[] = {"FC", "FDS", "SFC", "SUPA", "GB", "GBC", "SGB", "GBA",
+		"MGBA", "NDS", "MELONDS", "VB", "N64", "PKM", "POKE", NULL};
+	char cmd[2048] = {0};
+	FILE *f = fopen("/proc/self/cmdline", "r");
+	if (!f)
+		return 0;
+	size_t n = fread(cmd, 1, sizeof(cmd) - 1, f);
+	fclose(f);
+	const char *arg = cmd, *end = cmd + n;
+	for (int i = 0; i < 2 && arg < end; i++) // skip argv[0] and the core
+		arg += strlen(arg) + 1;
+	if (arg >= end)
+		return 0;
+	const char *slash = strrchr(arg, '/');
+	const char *close = NULL;
+	for (const char *c = arg; c < (slash ? slash : end); c++)
+		if (*c == ')')
+			close = c;
+	if (!close)
+		return 0;
+	const char *open = close;
+	while (open > arg && *open != '(')
+		open--;
+	if (*open != '(')
+		return 0;
+	char tag[16] = {0};
+	size_t len = close - open - 1;
+	if (len == 0 || len >= sizeof(tag))
+		return 0;
+	memcpy(tag, open + 1, len);
+	for (int i = 0; tags[i]; i++)
+		if (strcmp(tag, tags[i]) == 0)
+			return 1;
+	return 0;
+}
+static int nintendo_rom = -1;
+static int pad_original = 0; // minarch Controls > "Pad buttons": Original
+void PLAT_setPadButtons(int original) {
+	pad_original = !!original;
+}
+int PLAT_padButtonsApply(void) {
+	if (nintendo_rom < 0)
+		nintendo_rom = rom_is_nintendo();
+	return nintendo_rom;
+}
 static int controller_positional(void) {
-	static int positional = -1;
-	if (positional < 0)
-		positional = strcmp(program_invocation_short_name, "minarch.elf") == 0;
-	return positional;
+	static int in_minarch = -1;
+	if (in_minarch < 0)
+		in_minarch = strcmp(program_invocation_short_name, "minarch.elf") == 0;
+	// minarch's menu (players_active 0) uses the Xbox style like the launcher:
+	// the bottom button confirms there whatever the game layout.
+	return in_minarch && players_active && (!PLAT_padButtonsApply() || pad_original);
 }
 
