+// Chargeur branché ? (alimentation USB ou secteur « online ») — différent de
+// pwr.is_charging, qui retombe à 0 une fois la batterie pleine.
+static int SS_chargerOnline(void)
+{
+	DIR *dir = opendir("/sys/class/power_supply");
+	if (!dir) return 0;
+	struct dirent *ent;
+	int online = 0;
+	char path[300], value[16];
+	while (!online && (ent = readdir(dir)))
+	{
+		if (ent->d_name[0] == '.') continue;
+		snprintf(path, sizeof(path), "/sys/class/power_supply/%s/type", ent->d_name);
+		FILE *f = fopen(path, "r");
+		if (!f) continue;
+		int psu = fgets(value, sizeof(value), f) && (strncmp(value, "USB", 3) == 0 || strncmp(value, "Mains", 5) == 0);
+		fclose(f);
+		if (!psu) continue;
+		snprintf(path, sizeof(path), "/sys/class/power_supply/%s/online", ent->d_name);
+		if ((f = fopen(path, "r")))
+		{
+			online = fgets(value, sizeof(value), f) && value[0] == '1';
+			fclose(f);
+		}
+	}
+	closedir(dir);
+	return online;
+}
