+// Manette externe : un joystick au-delà de js0 (les touches intégrées).
+static int SS_padConnected(void)
+{
+	DIR *dir = opendir("/dev/input");
+	if (!dir) return 0;
+	struct dirent *ent;
+	int pads = 0;
+	while ((ent = readdir(dir)))
+		pads += strncmp(ent->d_name, "js", 2) == 0;
+	closedir(dir);
+	return pads > 1;
+}
