+#define SS_EDGE SCALE1(2)
+static SDL_Surface *SS_iconRow(int backed)
+{
+	static SDL_Surface *cache = NULL;
+	static char key[160];
+	char now[160], clockText[12] = "";
+	int shown[SS_ICON_COUNT], n = 0;
+	if (CFG_getShowClock())
+	{
+		time_t t = time(NULL);
+		struct tm tm = *localtime(&t);
+		strftime(clockText, sizeof(clockText), CFG_getClock24H() ? "%R" : "%-I:%M %p", &tm);
+	}
+	char *k = now;
+	k += sprintf(k, "%d %d %d %d %x %d %s ", SDL_AtomicGet(&pwr.charge), SS_plugged || SDL_AtomicGet(&pwr.is_charging),
+				 PLAT_connectionStrength(), SS_vpn, THEME_COLOR4_255, backed, clockText);
+	float units = 0;
+	for (int i = 0; i < SS_ICON_COUNT; i++)
+	{
+		shown[i] = SS_ICONS[i].shown();
+		k += sprintf(k, "%d", shown[i]);
+		if (shown[i]) { units += SS_ICONS[i].w; n++; }
+	}
+	if (cache && strcmp(now, key) == 0) return cache;
+	if (cache) SDL_FreeSurface(cache);
+	strcpy(key, now);
+
+	SDL_Surface *clock = clockText[0] ? TTF_RenderUTF8_Blended(font.tiny, clockText, uintToColour(THEME_COLOR4_255)) : NULL;
+	float kpx = SS_GLYPH / 14.0f;
+	int w = (int)ceilf(units * kpx) + (n - 1) * SS_GAP + 2 * SS_PAD_X + (clock ? SS_GAP + clock->w : 0);
+	int h = SS_GLYPH + 2 * SS_PAD_Y;
+	cache = SDL_CreateRGBSurfaceWithFormat(0, w, h, 32, SDL_PIXELFORMAT_ARGB8888);
+	if (!cache) { if (clock) SDL_FreeSurface(clock); return NULL; }
+	SDL_FillRect(cache, NULL, 0);
+	SDL_SetSurfaceBlendMode(cache, SDL_BLENDMODE_BLEND);
+	if (backed) SS_rrect(cache, 0, 0, w, h, h / 2.0f, 0x0000008cU);
+	SS_Pen pen = {cache, (float)(w - SS_PAD_X), (float)SS_PAD_Y, kpx, THEME_COLOR4_255, SS_alpha(THEME_COLOR4_255, 0.3f)};
+	for (int i = 0; i < SS_ICON_COUNT; i++)
+	{
+		if (!shown[i]) continue;
+		pen.x -= SS_ICONS[i].w * kpx;
+		SS_ICONS[i].draw(&pen);
+		pen.x -= SS_GAP;
+	}
+	if (clock) // horloge : à gauche des icônes, même axe
+	{
+		SDL_BlitSurface(clock, NULL, cache, &(SDL_Rect){SS_PAD_X, (h - clock->h) / 2});
+		SDL_FreeSurface(clock);
+	}
+	return cache;
+}
 
