@@ -2690,6 +2690,7 @@ SDL_Color GFX_mapColor(uint32_t c)
 
 pthread_mutex_t audio_mutex = PTHREAD_MUTEX_INITIALIZER;
 
+static volatile unsigned snd_starved = 0;
 static void SND_audioCallback(void *userdata, uint8_t *stream, int len)
 {
 	if (snd.frame_count == 0)
@@ -2712,8 +2713,10 @@ static void SND_audioCallback(void *userdata, uint8_t *stream, int len)
 	}
 	pthread_mutex_unlock(&audio_mutex);
 
-	if (len > 0)
+	if (len > 0) {
 		memset(out, 0, len * (sizeof(int16_t) * 2));
+		snd_starved++; // Save Sync : silences dus à un tampon vide (journal, mode stable)
